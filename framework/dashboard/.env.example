# cortextOS Dashboard Configuration
# Copy to .env and fill in your values

# Required: Path to cortextOS state directory
# Created by `cortextos init` (default: ~/.cortextos/default)
CTX_ROOT=~/.cortextos/default

# Required: Path to the cortextOS repo root
CTX_FRAMEWORK_ROOT=/path/to/cortextos

# Required: Dashboard auth secret — generate with: openssl rand -base64 32
# If unset, the dashboard will refuse to start (no insecure fallback)
AUTH_SECRET=your-secret-here

# Required for reverse-proxy or tunnel setups
AUTH_TRUST_HOST=true

# Dashboard admin credentials (created on first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Dashboard public URL — used for CORS and NextAuth redirects
# Set this to your Cloudflare Tunnel URL or public IP (e.g. https://xyz.trycloudflare.com)
# If unset, only localhost origins are allowed — cross-origin API calls will be blocked
NEXTAUTH_URL=https://your-tunnel.trycloudflare.com

# CORS: Additional allowed origin for the dashboard web UI
# Use if your dashboard runs at a different URL than NEXTAUTH_URL
# DASHBOARD_URL=https://your-dashboard-url.example.com

# CORS: Origin for the cortextOS mobile app (required if using the iOS/Android app)
# Without this, all mobile API calls will be rejected with Access-Control-Allow-Origin: null
# In development, Expo Go typically uses exp://localhost:8083 or the Metro dev server URL
MOBILE_APP_ORIGIN=https://your-tunnel.trycloudflare.com

# Optional: Instance ID (default: "default")
# CTX_INSTANCE_ID=default

# ---- Install-specific values (read by src/lib/install.ts) ----
# Every value below is optional. Unset = the default shown, or the feature is off.

# Org the memory, wiki and fleet views read (default: the first org found)
# CTX_ORG=myorg
# Seat that keeps ENTITIES.md, STATE.md and the proof tools in tools/ (default: the org's
# "orchestrator" in orgs/<org>/context.json)
# CTX_MEMORY_SEAT=orchestrator
# Seats listed on the Knowledge Base memory views, comma list (default: the org's switched-on seats)
# CTX_MEMORY_SEATS=orchestrator,analyst
# Display timezone, an IANA name; read at build time (default: UTC)
# CTX_TIMEZONE=America/New_York
# Obsidian vault, the readable copy of GBrain (default: unset, no vault views)
# CTX_VAULT_PATH=~/Documents/Vault
# Client work folders for Projects and CRM (default: ~/Clients)
# CTX_CLIENTS_ROOT=~/Clients
# Assignee names that mean a person, added to 'human' and 'user', comma list (default: none)
# CTX_HUMAN_ASSIGNEES=alex
# CRM: people-index names that are not contacts (friends, family), comma list (default: none)
# CTX_CRM_EXCLUDE=Alex Doe,Sam
# CRM: your own addresses or domains, never shown as a contact's, comma list (default: none)
# CTX_CRM_OWN=example.com
# CRM lead rows: a lead watch state file and who leads are sent to (default: unset, no lead rows)
# CTX_LEAD_WATCH_FILE=~/path/to/lead-watch-state.json
# CTX_LEAD_RECIPIENT=sales
# Instagram schedule page: conveyor folder with poster/schedule.json, and the account (default: unset)
# CTX_IG_CONVEYOR_DIR=~/path/to/ig-conveyor
# CTX_IG_ACCOUNT=youraccount
# Web push contact, a mailto: or https: URL (default: mailto:admin@localhost)
# CTX_PUSH_CONTACT=mailto:you@example.com
# gh config folder used to refresh the ogl-cortex docs mirror (default: gh's own)
# CTX_GH_CONFIG_DIR=~/.config/gh
# Team page job lines: write CTX_ROOT/config/team.json as {"<seat>": {"label": "...", "job": "..."}}
